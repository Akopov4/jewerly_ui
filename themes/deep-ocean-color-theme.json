  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#ffa657",
    "class": "#ffa657",
    "interface": "#79c0ff",
    "struct": "#ffa657",
    "enum": "#ffa657",
    "enumMember": "#f0883e",
    "typeParameter": "#ff7b72",
    "type": "#39d4c5",
    "function": "#79c0ff",
    "method": "#79c0ff",
    "property": "#39d4c5",
    "variable": "#cae8ff",
    "variable.readonly": "#cae8ff",
    "parameter": "#cae8ff",
    "decorator": "#ff9bce",
    "event": "#f0883e",
    "macro": "#ff9bce",
    "label": "#ff7b72",
    "keyword": "#ff7b72",
    "number": "#f0883e",
    "string": "#56d364",
    "regexp": "#39d4c5",
    "operator": "#39d4c5",
    "comment": {
      "foreground": "#484f58",
      "italic": true
    },
    "lifetime": "#ff9bce",
    "selfKeyword": "#ff9bce",
    "selfTypeKeyword": "#ff9bce",
    "concept": "#79c0ff",
    "templateFunction": "#79c0ff",
    "templateType": "#ffa657"
  }
}