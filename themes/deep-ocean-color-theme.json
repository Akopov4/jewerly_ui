    {
      "name": "XML \u2014 attribute name",
      "scope": [
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.localname.xml"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "XML \u2014 attribute value",
      "scope": [
        "string.quoted.double.xml",
        "string.quoted.single.xml"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "XML \u2014 namespace prefix",
      "scope": [
        "entity.other.attribute-name.namespace.xml",
        "entity.name.tag.namespace.xml"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "XML \u2014 namespace URI (xmlns value)",
      "scope": [
        "meta.tag.xml string.quoted"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "XML \u2014 CDATA block",
      "scope": [
        "string.unquoted.cdata.xml",
        "punctuation.definition.string.begin.xml",
        "punctuation.definition.string.end.xml"
      ],
      "settings": {
        "foreground": "#484f58"
      }
    },
    {
      "name": "XML \u2014 DOCTYPE",
      "scope": [
        "meta.tag.sgml.doctype.xml",
