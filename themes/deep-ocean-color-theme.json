      ],
      "settings": {
        "foreground": "#484f58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "XML \u2014 entity reference (&amp; &lt;\u2026)",
      "scope": [
        "constant.character.entity.xml",
        "punctuation.definition.constant.xml"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "XML \u2014 processing instruction",
