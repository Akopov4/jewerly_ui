        "constant.numeric.toml"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "TOML \u2014 datetime",
      "scope": [
        "constant.other.time.datetime.offset.toml",
        "constant.other.time.datetime.local.toml",
        "constant.other.time.date.toml",
        "constant.other.time.time.toml"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "TOML \u2014 boolean",
      "scope": [
        "constant.language.boolean.toml"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "TOML \u2014 comment",
      "scope": [
        "comment.line.number-sign.toml"
      ],
      "settings": {
        "foreground": "#484f58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Bash \u2014 shebang",
      "scope": [
        "comment.line.shebang"
      ],
      "settings": {
        "foreground": "#ff9bce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bash \u2014 built-in / function",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.function.shell"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Bash \u2014 control keyword",
      "scope": [
        "keyword.control.shell",
        "keyword.control.bash"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Bash \u2014 variable",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.bracket.shell",
        "variable.other.special.shell"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "Bash \u2014 operator",
      "scope": [
        "keyword.operator.pipe.shell",
        "keyword.operator.redirect.shell"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "Bash \u2014 flag / option",
      "scope": [
        "string.other.option.shell"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Dockerfile \u2014 instruction",
      "scope": [
        "keyword.other.special-method.dockerfile",
        "entity.name.function.dockerfile",
        "support.function.dockerfile"
      ],
      "settings": {
        "foreground": "#ff7b72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Dockerfile \u2014 image name",
      "scope": [
        "variable.other.readwrite.dockerfile",
        "entity.name.image.dockerfile"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Dockerfile \u2014 ARG/ENV variable",
      "scope": [
        "variable.env.dockerfile",
        "variable.other.env.dockerfile"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "XML \u2014 declaration (<?xml ... ?>)",
      "scope": [
        "meta.tag.preprocessor.xml",
        "punctuation.definition.tag.xml",
        "entity.name.tag.xml.declaration"
      ],
      "settings": {
        "foreground": "#484f58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "XML \u2014 tag name",
      "scope": [
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "XML \u2014 tag punctuation (< > </ />)",
      "scope": [
        "punctuation.definition.tag.begin.xml",
        "punctuation.definition.tag.end.xml"
      ],
      "settings": {
        "foreground": "#8b949e"
      }
