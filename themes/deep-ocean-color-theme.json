{
  "name": "Ocean Jewelry",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "colors": {},
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#484f58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "String escape / regexp",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "Template expression punctuation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none.python",
        "constant.language.true",
        "constant.language.false",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Keyword \u2014 control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Storage modifier",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.rust"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Keyword operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "new / delete / typeof / instanceof / sizeof",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Rust \u2014 lifetime",
      "scope": [
        "entity.name.lifetime.rust",
        "storage.modifier.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "Rust \u2014 macro",
      "scope": [
        "support.macro.rust",
        "entity.name.function.macro.rust",
        "meta.macro.rust"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "Function / method name",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.definition.method entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Class / struct / enum name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Interface name",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Type annotation / primitive",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "meta.type.annotation",
        "storage.type.primitive",
        "storage.type.built-in.primitive",
        "storage.type.c",
        "storage.type.cpp"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "Generic / type parameter",
      "scope": [
        "entity.name.type.parameter",
        "variable.type.var"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Enum member",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#cae8ff"
      }
    },
    {
      "name": "Function parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameter variable.other"
      ],
      "settings": {
        "foreground": "#cae8ff"
      }
    },
    {
      "name": "Object property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "Decorator / annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java",
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.section",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8b949e"
      }
    },
    {
      "name": "HTML \u2014 tag name",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "HTML \u2014 attribute name",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "HTML \u2014 attribute value",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "JSX component",
      "scope": [
        "support.class.component",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "JSX expression braces",
      "scope": [
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "CSS \u2014 tag selector",
      "scope": [
        "entity.name.tag.css",
        "source.css entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "CSS \u2014 class selector",
      "scope": [
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "CSS \u2014 id selector",
      "scope": [
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "CSS \u2014 pseudo-class",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "CSS \u2014 property name",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "CSS \u2014 property value",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "CSS \u2014 unit",
      "scope": [
        "keyword.other.unit.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "CSS \u2014 at-rule",
      "scope": [
        "keyword.control.at-rule",
        "keyword.control.at-rule.css"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "CSS \u2014 variable",
      "scope": [
        "variable.css",
        "support.variable.css"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "C/C++ \u2014 preprocessor",
      "scope": [
        "keyword.control.directive",
        "keyword.control.directive.include",
        "keyword.control.directive.define",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "C/C++ \u2014 macro",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.other.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "C/C++ \u2014 namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "C/C++ \u2014 pointer / reference",
      "scope": [
        "storage.modifier.pointer.cpp",
        "storage.modifier.reference.cpp"
      ],
      "settings": {
        "foreground": "#39d4c5"
      }
    },
    {
      "name": "YAML \u2014 key",
      "scope": [
        "entity.name.tag.yaml",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "YAML \u2014 string value",
      "scope": [
        "string.unquoted.plain.out.yaml",
        "string.unquoted.plain.in.yaml",
        "string.quoted.single.yaml",
        "string.quoted.double.yaml",
        "string.unquoted.block.yaml"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "YAML \u2014 anchor / alias",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml",
        "punctuation.definition.anchor.yaml",
        "punctuation.definition.alias.yaml"
      ],
      "settings": {
        "foreground": "#ff9bce"
      }
    },
    {
      "name": "YAML \u2014 boolean / null / number",
      "scope": [
        "constant.language.boolean.yaml",
        "constant.language.null.yaml",
        "constant.numeric.yaml"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "TOML \u2014 table header",
      "scope": [
        "entity.name.section.toml",
        "entity.name.table.toml",
        "support.type.property-name.table.toml",
        "keyword.other.table.toml",
        "keyword.other.table.array.toml"
      ],
      "settings": {
        "foreground": "#ffa657",
        "fontStyle": "bold"
      }
    },
    {
      "name": "TOML \u2014 key",
      "scope": [
        "support.type.property-name.toml",
        "variable.key.toml"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "TOML \u2014 string",
      "scope": [
        "string.quoted.single.toml",
        "string.quoted.double.toml",
        "string.quoted.triple.toml",
        "string.literal.toml",
        "string.basic.toml",
        "string.multiline.basic.toml",
        "string.multiline.literal.toml"
      ],
      "settings": {
        "foreground": "#56d364"
      }
    },
    {
      "name": "TOML \u2014 number / float",
      "scope": [
        "constant.numeric.integer.toml",
