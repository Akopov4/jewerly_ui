{
  "name": "Obsidian Syntax",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "colors": {},
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "String escape / special chars",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Template expression punctuation  (JS/TS  ${ })",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none.python",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Built-in constant (None/True/False Python, nullptr C++)",
      "scope": [
        "constant.language",
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Keyword \u2014 control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Storage modifier (async, static, public, const, let, var\u2026)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.rust"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Keyword operator (arithmetic, comparison, logical)",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "new / delete / typeof / instanceof / sizeof",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Python \u2014 import / from / as / in / not / and / or / is",
      "scope": [
        "keyword.control.import.python",
        "keyword.control.flow.python",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike.python"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Rust \u2014 lifetime",
      "scope": [
        "entity.name.lifetime.rust",
        "storage.modifier.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Rust \u2014 macro invocation",
      "scope": [
        "support.macro.rust",
        "entity.name.function.macro.rust",
        "meta.macro.rust"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Function / method name \u2014 definition",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.definition.method entity.name.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Built-in / support functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Class / struct / enum name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Interface name (TS / Java)",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#74c7ec"
      }
    },
    {
      "name": "Type annotation / primitive type",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "meta.type.annotation",
        "storage.type.primitive",
        "storage.type.built-in.primitive",
        "storage.type.c",
        "storage.type.cpp"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Generic / type parameter",
      "scope": [
        "entity.name.type.parameter",
        "variable.type.var"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Enum member / constant",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Function parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameter variable.other"
      ],
      "settings": {
        "foreground": "#f2cdcd"
      }
    },
    {
      "name": "Object property / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Decorator / annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Punctuation \u2014 braces, brackets, parens",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.section",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#9399b2"
      }
    },
    {
      "name": "Punctuation \u2014 separator / terminator",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9399b2"
      }
    },
    {
      "name": "HTML \u2014 tag name",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "HTML \u2014 attribute name",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "HTML \u2014 attribute value / string",
